{
  "name": "label",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Cour de cassation annotation tool.",
  "homepage": "/label",
  "scripts": {
    "start:dev": "vite",
    "build": "vite build",
    "compile": "tsc",
    "preview": "vite preview",
    "start:docker": "docker compose up -d",
    "test": "npm run compile && vitest run",
    "format": "prettier \"src/**/*.{ts,tsx}\" --check",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "fix": "eslint \"src/**/*.{ts,tsx}\" --fix && prettier \"src/**/*.{ts,tsx}\" --write"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "dateformat": "5.0.3",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "string-template": "1.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint-react/eslint-plugin": "5.28.4",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/dateformat": "5.0.3",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/string-template": "1.0.7",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
